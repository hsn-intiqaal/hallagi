{
  "name": "hallagi-client",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadlessCI --code-coverage",
    "e2e": "playwright test",
    "icons": "python3 scripts/generate-icons.py --native",
    "build:mobile": "ng build --configuration production && cap sync",
    "android": "npm run build:mobile && cap open android",
    "ios": "npm run build:mobile && cap open ios",
    "lint": "ng lint"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.2.0",
    "@angular/compiler": "^20.2.0",
    "@angular/core": "^20.2.0",
    "@angular/forms": "^20.2.0",
    "@angular/platform-browser": "^20.2.0",
    "@angular/router": "^20.2.0",
    "@angular/service-worker": "^20.3.33",
    "@capacitor/android": "^7.6.10",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.10",
    "@capacitor/ios": "^7.6.10",
    "@capacitor/splash-screen": "^7.0.5",
    "@capacitor/status-bar": "^7.0.6",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "chart.js": "^4.5.1",
    "lucide-angular": "^0.535.0",
    "qrcode": "1.5.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.2.1",
    "@angular/cli": "^20.2.1",
    "@angular/compiler-cli": "^20.2.0",
    "@capacitor/cli": "^7.6.10",
    "@playwright/test": "^1.64.0",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.5",
    "angular-eslint": "^20.7.0",
    "eslint": "^9.39.5",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.72.1"
  }
}
