# ===== حلاقي — متغيرات البيئة =====
# انسخ هذا الملف إلى .env (لا يُرفع للمستودع) وضع قيمًا حقيقية.
# ASP.NET Core يقرأ المتغيرات بشرطة سفلية مزدوجة (__) بدل النقطتين.

# ----------------------------------------------------------------------
# docker compose (docker-compose.yml)
# ----------------------------------------------------------------------
DB_PASSWORD="Change_Me_Str0ng!"               # كلمة مرور SQL Server (sa)
JWT_KEY="CHANGE-ME-TO-A-RANDOM-SECRET-OF-32+CHARS"
ADMIN_EMAIL="admin@your-domain.sa"           # أول حساب مالك منصة (يُنشأ مرة واحدة)
ADMIN_PASSWORD="CHANGE-ME-12+CHARS"
SEED_DEMO="false"                            # true = بيانات العرض التجريبية (لا تستخدمه في الإنتاج)
PUBLIC_URL="https://app.your-domain.sa"
WEB_PORT="8080"

# ----------------------------------------------------------------------
# تشغيل الخادم مباشرة (بدون Docker)
# ----------------------------------------------------------------------
# قاعدة البيانات: SqlServer (افتراضي) أو Sqlite (عرض محلي سريع بدون SQL Server)
Database__Provider="SqlServer"
ConnectionStrings__Default="Server=(localdb)\MSSQLLocalDB;Database=Hallagi;Trusted_Connection=True;TrustServerCertificate=True"
# Database__Provider="Sqlite"
# ConnectionStrings__Default="Data Source=hallagi.db"
Database__MigrateOnStartup="true"

# المصادقة — مفتاح 32 حرفًا على الأقل وغير الافتراضي (إلزامي في الإنتاج)
Jwt__Key="CHANGE-ME-TO-A-RANDOM-SECRET-OF-32+CHARS"
Jwt__Issuer="Hallagi"
Jwt__Audience="Hallagi"
Jwt__ExpiryMinutes="60"          # عمر توكن الوصول — يتجدد تلقائيًا
Jwt__RefreshTokenDays="30"       # عمر توكن التجديد (يُدوَّر مع كل استخدام)

# أول مالك منصة في الإنتاج (12 حرفًا على الأقل) — يُتجاهل إذا وُجد مالك منصة
Bootstrap__AdminEmail=""
Bootstrap__AdminPassword=""

# بيانات العرض التجريبية (تطوير/عرض فقط)
Seed__OnStartup="false"

# الحماية من محاولات التخمين (لكل IP في الدقيقة)
RateLimiting__AuthPerMinute="10"
RateLimiting__PublicPerMinute="60"

# أصول الواجهة المسموح لها (CORS) — غير مطلوب عند خدمة الواجهة والخادم من نفس النطاق
Cors__AllowedOrigins__0="http://localhost:4200"
