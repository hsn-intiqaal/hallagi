# ===== حلاقي — متغيرات البيئة المطلوبة =====
# انسخ هذا الملف إلى .env ولا تضع قيمًا حقيقية في مستودع الكود.
# في ASP.NET Core تُقرأ متغيرات البيئة بشرطة سفلية مزدوجة (__) بدل نقطتين.

# ----------------------------------------------------------------------
# قاعدة البيانات (SQL Server)
# ----------------------------------------------------------------------
# LocalDB (للتطوير المحلي):
ConnectionStrings__Default="Server=(localdb)\MSSQLLocalDB;Database=Hallagi;Trusted_Connection=True;TrustServerCertificate=True"

# SQL Server Express:
# ConnectionStrings__Default="Server=.\SQLEXPRESS;Database=Hallagi;Trusted_Connection=True;TrustServerCertificate=True"

# SQL Server كامل مع مستخدم:
# ConnectionStrings__Default="Server=YOUR_SERVER;Database=Hallagi;User Id=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=True"

# ----------------------------------------------------------------------
# المصادقة (JWT) — مفتاح 32 حرفًا على الأقل إلزاميًا في الإنتاج
# ----------------------------------------------------------------------
Jwt__Key="CHANGE-ME-TO-A-STRONG-SECRET-32+CHARS"
Jwt__Issuer="Hallagi"
Jwt__Audience="Hallagi"
Jwt__ExpiryMinutes="720"

# ----------------------------------------------------------------------
# بيانات تجريبية عند أول تشغيل (تطوير/عرض فقط — أوقفه في الإنتاج)
# ----------------------------------------------------------------------
Seed__OnStartup="false"

# ----------------------------------------------------------------------
# أصول الواجهة المسموح لها بالاتصال (CORS)
# ----------------------------------------------------------------------
Cors__AllowedOrigins__0="http://localhost:4200"
# Cors__AllowedOrigins__1="https://your-frontend-domain.com"

# ----------------------------------------------------------------------
# الواجهة (Angular) — عنوان الخادم
# ----------------------------------------------------------------------
# في hallagi-client/src/environments/environment.ts
# apiUrl: 'http://localhost:5095/api'
